  "narrative": {
    "northStar": "The Quiet Placement Desk",
    "overview": "A recruitment portal that behaves like a well-run agency desk: calm, legible, organised around status. Forest green anchors identity; green-tinted paper, hairline borders and dark ink carry the rest; lime is a rare signal.",
    "keyCharacteristics": [
      "Forest green + lime with green-tinted neutrals",
      "Flat bordered surfaces; shadow only for hover, modal, toast",
      "Status as colour pill + dot + text",
      "Manrope headings, DM Sans body",
      "3px focus ring, 44px coarse-pointer targets, 12px floor, 4.5:1 contrast"
    ],
    "rules": [
      {
        "name": "The One Lime Rule",
        "body": "Lime appears once or twice per screen as a signal, never as a fill for large content areas (the login circle is the single decorative exception).",
        "section": "colors"
      },
      {
        "name": "The Tinted Neutral Rule",
        "body": "Every neutral carries a slight green cast; no cool or pure grays, no new near-duplicate tints.",
        "section": "colors"
      },
      {
        "name": "The Token-Only Rule",
        "body": "Rules reference var(--token); a new colour needs a named token with a role.",
        "section": "colors"
      },
      {
        "name": "The Two-Voice Rule",
        "body": "Manrope for things you scan, DM Sans for things you read.",
        "section": "typography"
      },
      {
        "name": "The 12px Floor Rule",
        "body": "No running text below 12px; only uppercase tracked kickers may use 11px.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces carry borders, not shadows, at rest; shadows appear only for hover lift, overlays, and focus.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Use var(--token) for every colour",
      "Pair every status with its fg/bg tokens and a text label",
      "Keep body text at 12px+ and 4.5:1 contrast",
      "Keep the 3px focus ring on every interactive element",
      "Give touch targets at least 44px on coarse pointers and at 740px or narrower",
      "Honour prefers-reduced-motion"
    ],
    "donts": [
      "Add dark mode or cool grays",
      "Use lime as a large fill or as text on light backgrounds",
      "Convey status by colour alone",
      "Add shadows to resting cards",
      "Mix Manrope and DM Sans in a text run",
      "Introduce new radii or near-duplicate tints"
    ]
  }
